# ─────────────────────────────────────────────────────────────
#  Nuestra Raza — variables de entorno
#  Copia este archivo a `.env.local` y completa los valores.
#  Solo las variables con prefijo VITE_ llegan al navegador:
#  NUNCA pongas secretos (API keys privadas) en una variable VITE_.
# ─────────────────────────────────────────────────────────────

# URL pública del sitio, sin barra final. Se usa para URLs canónicas,
# Open Graph, sitemap.xml y robots.txt.
VITE_SITE_URL=http://localhost:3000

# (Opcional) Número de WhatsApp que recibe reservas y consultas,
# en formato internacional SIN "+" ni espacios (ej. 51XXXXXXXXX).
# Si se define, tiene prioridad sobre `contact.whatsapp` de site.config.ts
# (útil para usar un número de pruebas en staging).
VITE_WHATSAPP_NUMBER=

# (Opcional) Endpoint HTTP que recibirá las solicitudes de reserva como JSON (POST).
# Si se define, reemplaza el flujo de WhatsApp por un backend de reservas.
VITE_RESERVATIONS_ENDPOINT=

# (Opcional) Endpoint HTTP que recibirá los mensajes del formulario de contacto (POST JSON).
# Ej.: un servicio de formularios o una función serverless propia.
VITE_CONTACT_ENDPOINT=
